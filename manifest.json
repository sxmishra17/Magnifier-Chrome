{
  "manifest_version": 3,
  "name": "Magnifier",
  "version": "1.3.0",
  "description": "Magnify text, images & PDFs with a customizable lens. Zoom 1x-10x, three sizes, circle or rectangle, five cursor positions.",
  "author": "Satish Mishra (satishmishra17@gmail.com)",

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Magnifier Settings",
    "default_popup": "popup/popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "locales.js",
        "pdf-viewer/*",
        "whats-new/*",
        "icons/yuvatechlogo.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
